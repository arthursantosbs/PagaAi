# Copie para .env e preencha. O .env NAO vai para o git.

# Dominio que aponta para o servidor (o Caddy emite o certificado para ele).
DOMINIO=pagaai.seudominio.com.br

# Banco
DB_NAME=pagaai
DB_USER=pagaai
DB_PASSWORD=troque-por-uma-senha-longa

# Primeiro acesso. Depois de entrar, troque a senha pela tela de Usuarios.
ADMIN_LOGIN=HERA123
ADMIN_SENHA=troque-esta-senha

# Deixe true. So use false para testar por http, sem dominio/certificado.
COOKIE_SECURE=true

# Por quantos dias guardar os backups diarios (ficam em ./backups no servidor).
BACKUP_DIAS=30
